# ============================================
# BANCO DE DADOS
# ============================================
DATABASE_URL=postgresql://neondb_owner:password@localhost:5432/novalis
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=30000

# ============================================
# AUTENTICAÇÃO
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=30d

# ============================================
# SERVIDOR
# ============================================
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug

# ============================================
# ARMAZENAMENTO (AWS S3 ou LOCAL)
# ============================================
STORAGE_TYPE=local
# Se local:
STORAGE_LOCAL_PATH=./uploads
# Se S3:
AWS_REGION=us-east-1
AWS_S3_BUCKET=novalis-uploads
AWS_S3_PREFIX=uploads/
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# ============================================
# VISÃO COMPUTACIONAL / OCR
# ============================================
VISION_PROVIDER=google
# Google Vision API
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_API_KEY=your-google-api-key
# OpenAI Vision (alternativa)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-vision-preview

# ============================================
# OCR (Tesseract ou AWS Textract)
# ============================================
OCR_ENGINE=tesseract
# Se AWS Textract:
TEXTRACT_REGION=us-east-1

# ============================================
# EMAIL (Opcional - para notificações)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=novalis@kauanovs.dev

# ============================================
# REDIS (Cache - Opcional)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# LOGGING
# ============================================
LOG_FORMAT=json
LOG_DESTINATION=console,file
LOG_FILE_PATH=./logs/app.log

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# SECURITY
# ============================================
ENABLE_HTTPS=false
HELMET_ENABLED=true
HELMET_CSP_ENABLED=false

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_ADVANCED_MATCHING=true
FEATURE_AI_VALIDATION=true
FEATURE_EXPORT_JSON=true

# ============================================
# SUPABASE (Alternativa ao PostgreSQL)
# ============================================
# Descomente se usar Supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# ============================================
# SENTRY (Error Tracking)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
