{
  "name": "novalis-backend",
  "version": "1.0.0",
  "description": "Backend API para Novalis - Sistema de Inteligência Imobiliária",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node --loader ts-node/esm src/db/migrate.ts",
    "db:seed": "node --loader ts-node/esm src/db/seed.ts",
    "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed",
    "db:drop": "node --loader ts-node/esm src/db/drop.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --loader ts-node/esm src/tests/e2e/setup.ts && vitest run src/tests/e2e",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["real-estate", "intelligence", "ocr", "vision", "document-processing"],
  "author": "Kauã Santos Novaes",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "prisma": "^5.7.1",
    "@prisma/client": "^5.7.1",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "axios": "^1.6.5",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "pdfparse": "^1.1.1",
    "xlsx": "^0.18.5",
    "tesseract.js": "^5.0.4",
    "redis": "^4.6.12",
    "ioredis": "^5.3.2",
    "bull": "^4.11.5",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
